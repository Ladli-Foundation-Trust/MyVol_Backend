generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  REVIEWER
  ADMIN
}

// ACTIVE is the only status that can use the API. DEACTIVATED and PENDING_DELETION
// flip back to ACTIVE on the next successful login; SUSPENDED is set by moderators.
enum AccountStatus {
  ACTIVE
  DEACTIVATED
  PENDING_DELETION
  SUSPENDED
}

enum CodePurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
}

// The app shows UNDER_REVIEW posts only to their author. Until the moderation phase,
// POST_AUTO_APPROVE=true makes new posts APPROVED at once.
enum PostStatus {
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum AuthProvider {
  GOOGLE
}

// What a notification is about. The API sends these lower-cased with shorter names
// (POST_LIKE → "like"); see notificationService.TYPE_NAMES.
enum NotificationType {
  FOLLOW
  FOLLOW_REQUEST
  FOLLOW_ACCEPTED
  POST_LIKE
  POST_COMMENT
  COMMENT_REPLY
  COMMENT_LIKE
  POST_APPROVED
  POST_REJECTED
}

model User {
  id                  String        @id @default(uuid()) @db.Uuid
  // Every account has an email, a phone, or both. Phone accounts may have no email.
  email               String?       @unique
  // E.164 (+919876543210). Not unique: one number can own up to MAX_ACCOUNTS_PER_PHONE
  // accounts. Only ever set after an SMS code proves the number, so it is always verified.
  phone               String?
  username            String        @unique
  name                String
  bio                 String?
  // Storage key (e.g. "avatars/<uuid>.webp"), not a URL: the URL is built at read
  // time, so moving to S3/a CDN needs no data migration.
  avatarKey           String?       @map("avatar_key")
  // Private: only approved followers see the profile details, lists and (later) posts.
  isPrivate           Boolean       @default(false) @map("is_private")
  // Denormalised so profiles and lists don't COUNT(*) on every view. Changed only
  // in the same transaction as the follows row (followService).
  followersCount      Int           @default(0) @map("followers_count")
  followingCount      Int           @default(0) @map("following_count")
  usernameChangedAt   DateTime?     @map("username_changed_at")
  role                Role          @default(USER)
  status              AccountStatus @default(ACTIVE)
  dateOfBirth         DateTime?     @map("date_of_birth") @db.Date
  emailVerifiedAt     DateTime?     @map("email_verified_at")
  // Null for accounts created through Google until the user sets a password.
  passwordHash        String?       @map("password_hash")
  passwordChangedAt   DateTime?     @map("password_changed_at")
  failedLoginCount    Int           @default(0) @map("failed_login_count")
  lockedUntil         DateTime?     @map("locked_until")
  lastLoginAt         DateTime?     @map("last_login_at")
  termsAcceptedAt     DateTime?     @map("terms_accepted_at")
  deactivatedAt       DateTime?     @map("deactivated_at")
  deletionScheduledAt DateTime?     @map("deletion_scheduled_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  sessions          Session[]
  verificationCodes VerificationCode[]
  oauthAccounts     OAuthAccount[]
  authEvents        AuthEvent[]
  profile           Profile?
  following         Follow[]           @relation("follower")
  followers         Follow[]           @relation("following")
  sentRequests      FollowRequest[]    @relation("requester")
  receivedRequests  FollowRequest[]    @relation("target")
  posts             Post[]
  postLikes         PostLike[]
  postSaves         PostSave[]
  postViews         PostView[]
  comments          Comment[]
  commentLikes      CommentLike[]
  notifications     Notification[]     @relation("recipient")
  notificationsSent Notification[]     @relation("actor")
  settings          UserSettings?
  blocksMade        Block[]            @relation("blocker")
  blocksReceived    Block[]            @relation("blocked")
  mutesMade         Mute[]             @relation("muter")
  mutesReceived     Mute[]             @relation("muted")
  reportsMade       Report[]           @relation("reporter")
  reportsReceived   Report[]           @relation("reportedUser")
  reportsResolved   Report[]           @relation("resolver")
  moderationActions ModerationAction[]

  @@index([status, deletionScheduledAt])
  @@index([phone])
  // Search: trigram indexes make ILIKE '%word%' and similarity() fast (pg_trgm).
  @@index([username(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_username_trgm_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_name_trgm_idx")
  @@map("users")
}

// One row per logged-in device. Refresh tokens rotate inside a session; revoking
// the session kills its refresh token and, through `protect`, its access tokens.
model Session {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  deviceName    String?   @map("device_name")
  userAgent     String?   @map("user_agent")
  ip            String?
  expiresAt     DateTime  @map("expires_at")
  lastUsedAt    DateTime  @default(now()) @map("last_used_at")
  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?   @map("revoked_reason")
  createdAt     DateTime  @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  // Set when the token is exchanged. Presenting a used token again = theft.
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// Short-lived 6-digit codes. Only an HMAC of the code is stored.
model VerificationCode {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  purpose   CodePurpose
  codeHash  String      @map("code_hash")
  // The new address for EMAIL_CHANGE; null otherwise.
  target    String?
  attempts  Int         @default(0)
  expiresAt DateTime    @map("expires_at")
  usedAt    DateTime?   @map("used_at")
  createdAt DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("verification_codes")
}

// 6-digit SMS codes. Keyed by the number, not a user: the number is verified before
// the account exists (phone signup) and may belong to several accounts (phone login).
// A correct code sets verified_at and the client gets a phoneToken; using that token
// (signup, login, reset, change) sets consumed_at, so each code works for one action.
model PhoneCode {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([phone, createdAt])
  @@index([createdAt])
  @@map("phone_codes")
}

model OAuthAccount {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  provider       AuthProvider
  providerUserId String       @map("provider_user_id")
  email          String?
  createdAt      DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

// Append-only security log (logins, failures, password changes, token reuse...).
model AuthEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  type      String
  ip        String?
  userAgent String?  @map("user_agent")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("auth_events")
}

// Extended volunteer profile (the app's Profile Details screen). Optional 1:1 row,
// created on first edit. Option lists are validated in userValidators, not as DB
// enums, so the app can add options without a migration.
model Profile {
  userId              String   @id @map("user_id") @db.Uuid
  gender              String?
  country             String?
  state               String?
  city                String?
  qualification       String?
  fieldOfStudy        String?  @map("field_of_study")
  skills              String[] @default([])
  preferredAreas      String[] @default([]) @map("preferred_areas")
  availability        String[] @default([])
  volunteeringTypes   String[] @default([]) @map("volunteering_types")
  // Gender, date of birth and education are shown to others only when this is on.
  showPersonalDetails Boolean  @default(false) @map("show_personal_details")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Follow {
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  // "followers of X, newest first" and "who X follows, newest first"
  @@index([followingId, createdAt])
  @@index([followerId, createdAt])
  @@map("follows")
}

// A pending follow of a private account. Accepting turns it into a Follow.
model FollowRequest {
  requesterId String   @map("requester_id") @db.Uuid
  targetId    String   @map("target_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  requester User @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  target    User @relation("target", fields: [targetId], references: [id], onDelete: Cascade)

  @@id([requesterId, targetId])
  @@index([targetId, createdAt])
  @@map("follow_requests")
}

// A volunteering activity. Counters are denormalised like follows (D32) and only
// change in the same transaction as the like/save/comment row (postService).
model Post {
  id              String     @id @default(uuid()) @db.Uuid
  authorId        String     @map("author_id") @db.Uuid
  title           String
  description     String?
  location        String?
  category        String
  beneficiaries   Int        @default(0)
  hours           Int        @default(0)
  status          PostStatus @default(UNDER_REVIEW)
  rejectionReason String?    @map("rejection_reason")
  likesCount      Int        @default(0) @map("likes_count")
  commentsCount   Int        @default(0) @map("comments_count")
  savesCount      Int        @default(0) @map("saves_count")
  sharesCount     Int        @default(0) @map("shares_count")
  // Unique viewers of a video post (the author's own plays don't count).
  viewsCount      Int        @default(0) @map("views_count")
  // A reel = a post whose only media item is a video. Set on create; drives /posts/reels.
  isReel          Boolean    @default(false) @map("is_reel")
  createdAt       DateTime   @default(now()) @map("created_at")
  // Set only when the author edits the text. Not @updatedAt: counter changes
  // (likes, comments) update the row too and must not look like an edit.
  editedAt        DateTime?  @map("edited_at")

  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media         PostMedia[]
  likes         PostLike[]
  saves         PostSave[]
  comments      Comment[]
  views         PostView[]
  notifications Notification[]
  reports       Report[]
  hashtags      PostHashtag[]

  @@index([authorId, createdAt])
  @@index([isReel, status, createdAt])
  @@index([status, createdAt])
  @@index([category, status, createdAt])
  // Search: trigram indexes make ILIKE '%word%' fast (pg_trgm).
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "posts_title_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "posts_description_trgm_idx")
  @@map("posts")
}

model PostMedia {
  id           String    @id @default(uuid()) @db.Uuid
  postId       String    @map("post_id") @db.Uuid
  type         MediaType
  // Storage key, like users.avatar_key (see lib/storage.js).
  key          String
  width        Int
  height       Int
  position     Int
  // Videos only: the cover image (WebP) and length.
  thumbnailKey String?   @map("thumbnail_key")
  durationMs   Int?      @map("duration_ms")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, position])
  @@map("post_media")
}

model PostLike {
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId, createdAt])
  @@map("post_likes")
}

model PostSave {
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([userId, createdAt])
  @@map("post_saves")
}

// One row per (viewer, video post): the first play counts as a view, later plays add
// to plays and watch time (for ranking reels later).
model PostView {
  userId       String   @map("user_id") @db.Uuid
  postId       String   @map("post_id") @db.Uuid
  plays        Int      @default(1)
  watchMs      Int      @default(0) @map("watch_ms")
  createdAt    DateTime @default(now()) @map("created_at")
  lastViewedAt DateTime @default(now()) @map("last_viewed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@map("post_views")
}

// One level of replies: parent_id points at a top-level comment, never at a reply.
model Comment {
  id           String   @id @default(uuid()) @db.Uuid
  postId       String   @map("post_id") @db.Uuid
  authorId     String   @map("author_id") @db.Uuid
  parentId     String?  @map("parent_id") @db.Uuid
  text         String
  likesCount   Int      @default(0) @map("likes_count")
  repliesCount Int      @default(0) @map("replies_count")
  createdAt    DateTime @default(now()) @map("created_at")

  post          Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent        Comment?       @relation("replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[]      @relation("replies")
  likes         CommentLike[]
  notifications Notification[]
  reports       Report[]

  @@index([postId, parentId, createdAt])
  @@index([parentId, createdAt])
  @@map("comments")
}

model CommentLike {
  userId    String   @map("user_id") @db.Uuid
  commentId String   @map("comment_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
  @@map("comment_likes")
}

// The Activity tab. One row per event, unique per (recipient, dedupe_key), so a double
// tap or like→unlike→like can't stack duplicates; undoing the action (unlike, unfollow,
// cancel request) deletes the row. Rows about a deleted post/comment/actor cascade away.
// The message text is built at read time from the actor/post/comment, never stored.
model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  recipientId String           @map("recipient_id") @db.Uuid
  // Null for system notifications (post approved/rejected).
  actorId     String?          @map("actor_id") @db.Uuid
  type        NotificationType
  postId      String?          @map("post_id") @db.Uuid
  commentId   String?          @map("comment_id") @db.Uuid
  // e.g. "like:<postId>:<actorId>"; see notificationService.
  dedupeKey   String           @map("dedupe_key")
  readAt      DateTime?        @map("read_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  recipient User     @relation("recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User?    @relation("actor", fields: [actorId], references: [id], onDelete: Cascade)
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([recipientId, dedupeKey])
  // The list (newest first) and the unread count.
  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
  // Cascading deletes look these up.
  @@index([actorId])
  @@index([postId])
  @@index([commentId])
  @@map("notifications")
}

// App settings as one JSONB object of flat keys matching the app's settingsSlice
// (pauseAll, notifLikes...). Missing keys fall back to defaults in settingsService,
// so adding a setting needs no migration. Only the notification keys exist so far;
// the settings phase adds the rest.
model UserSettings {
  userId    String   @id @map("user_id") @db.Uuid
  data      Json     @default("{}")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// A blocks B: B can't find A (404), see A's posts or comments, follow or contact A.
// A still sees B's profile (to unblock) but none of B's content. Blocking removes
// follows and follow requests both ways (blockService). Directional: the row says who
// did it, the rule applies both ways (socialGraph.notBlockedWith).
model Block {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@index([blockerId, createdAt])
  @@map("blocks")
}

// A mutes B: B's posts leave A's home feed, explore and reels. B is not told and can
// still see A. Nothing else changes (they can still follow each other).
model Mute {
  muterId   String   @map("muter_id") @db.Uuid
  mutedId   String   @map("muted_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  muter User @relation("muter", fields: [muterId], references: [id], onDelete: Cascade)
  muted User @relation("muted", fields: [mutedId], references: [id], onDelete: Cascade)

  @@id([muterId, mutedId])
  @@index([mutedId])
  @@index([muterId, createdAt])
  @@map("mutes")
}

enum ReportType {
  POST
  COMMENT
  USER
  // The app's "Report a problem" form (bugs, account issues, ideas): no target.
  PROBLEM
}

enum ReportReason {
  SPAM
  NUDITY
  HATE_SPEECH
  HARASSMENT
  VIOLENCE
  SELF_HARM
  FALSE_INFORMATION
  SCAM
  INTELLECTUAL_PROPERTY
  FAKE_ACCOUNT
  OTHER
}

enum ReportStatus {
  OPEN
  // A moderator acted (removed the content, suspended the user, fixed the problem).
  RESOLVED
  // Looked at, no violation.
  DISMISSED
}

// Reports are anonymous to the reported person. One OPEN report per reporter and
// target (reportService). A report outlives its target (SET NULL), so the record of
// what was reported and what was done stays.
model Report {
  id           String        @id @default(uuid()) @db.Uuid
  reporterId   String        @map("reporter_id") @db.Uuid
  type         ReportType
  reason       ReportReason?
  // PROBLEM reports: the app's category (bug, content, account, idea).
  category     String?
  details      String?
  // PROBLEM reports: "app v1.0.0, Android 14" if the user allowed it.
  deviceInfo   String?       @map("device_info")
  postId       String?       @map("post_id") @db.Uuid
  commentId    String?       @map("comment_id") @db.Uuid
  // USER reports: the reported account. POST/COMMENT reports: the content's author.
  userId       String?       @map("user_id") @db.Uuid
  status       ReportStatus  @default(OPEN)
  resolvedById String?       @map("resolved_by_id") @db.Uuid
  resolvedAt   DateTime?     @map("resolved_at")
  // What the moderator did: dismiss | resolve | remove | suspend, plus their note.
  resolution   String?
  createdAt    DateTime      @default(now()) @map("created_at")

  reporter   User     @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  user       User?    @relation("reportedUser", fields: [userId], references: [id], onDelete: SetNull)
  resolvedBy User?    @relation("resolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  post       Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  comment    Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)

  // The moderation queue: open reports of a type, oldest first.
  @@index([status, type, createdAt])
  @@index([postId, status])
  @@index([commentId, status])
  @@index([userId, status])
  @@index([reporterId, createdAt])
  @@map("reports")
}

// Append-only log of what staff (and the automatic report threshold) did, for
// accountability and appeals. moderator_id is null for automatic actions.
model ModerationAction {
  id          String   @id @default(uuid()) @db.Uuid
  moderatorId String?  @map("moderator_id") @db.Uuid
  // APPROVE_POST, REJECT_POST, AUTO_HIDE_POST, DELETE_COMMENT, SUSPEND_USER,
  // UNSUSPEND_USER, SET_ROLE, DISMISS_REPORT, RESOLVE_REPORT
  action      String
  // post | comment | user | report
  targetType  String   @map("target_type")
  targetId    String   @map("target_id") @db.Uuid
  reason      String?
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  moderator User? @relation(fields: [moderatorId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId, createdAt])
  @@index([moderatorId, createdAt])
  @@index([createdAt])
  @@map("moderation_actions")
}

// #tags found in a post's title and description (lower-cased, without '#').
// posts_count is kept by postService and recounted by the cleanup job.
model Hashtag {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @unique
  postsCount Int      @default(0) @map("posts_count")
  createdAt  DateTime @default(now()) @map("created_at")

  posts PostHashtag[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "hashtags_name_trgm_idx")
  @@map("hashtags")
}

model PostHashtag {
  postId    String @map("post_id") @db.Uuid
  hashtagId String @map("hashtag_id") @db.Uuid

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtag Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@id([postId, hashtagId])
  @@index([hashtagId, postId])
  @@map("post_hashtags")
}
