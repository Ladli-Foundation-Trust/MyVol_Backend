{
  "name": "myvolapp-backend",
  "version": "0.1.0",
  "private": true,
  "description": "MyVolApp API — Express + PostgreSQL + Prisma",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:seed:demo": "node scripts/seed-demo.js",
    "db:seed:e2e": "node scripts/seed-e2e.js",
    "auth:cleanup": "node scripts/auth-cleanup.js",
    "db:clean-postman": "node scripts/clean-postman-data.js",
    "ws:listen": "node scripts/ws-listen.js",
    "user:role": "node scripts/set-role.js",
    "pretest": "node --env-file=.env.test node_modules/prisma/build/index.js migrate deploy",
    "test": "node --env-file=.env.test --test --test-concurrency=1 \"test/**/*.test.js\"",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "ffmpeg-static": "^5.3.0",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.2",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "3.1.14",
    "prisma": "7.10.1",
    "supertest": "^7.3.1"
  }
}
