# Dependencies
node_modules/

# Env files: none are committed, not even the *.example templates (team decision).
# Share .env.example privately with new developers.
.env
.env.*
*.pem
*.key

# Generated Prisma client (rebuilt by `npm install` / `prisma generate`)
src/generated/

# Postman: collections, environments and run reports stay local (they can hold tokens)
postman/
*.postman_collection.json
*.postman_environment.json
*.postman_globals.json
postman-cli-reports/
newman/

# Logs
*.log
logs/
npm-debug.log*

# Tests: suites, e2e seed data and the testing guide stay local
test/
tests/
*.test.js
*.spec.js
TESTING.md
scripts/seed-e2e.js

# Test coverage
coverage/
.nyc_output/

# Uploads and temp files
uploads/
tmp/
*.tmp

# Editors
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini
