NODE_ENV=development
PORT=3000
APP_NAME=MyVolApp

# Postgres connection: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Locally this is the "myvolapp" app role (not the postgres superuser). See README.
DATABASE_URL="postgresql://myvolapp:CHANGE_ME@localhost:5432/myvolapp?schema=public"

# Comma-separated; empty = allow all (dev only)
CORS_ORIGINS=

# Auth — generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
MAX_SESSIONS_PER_USER=10
OTP_SECRET=CHANGE_ME_min_32_chars
PASSWORD_RESET_TTL_MINUTES=10
EMAIL_CODE_TTL_MINUTES=15
# 13 = COPPA minimum. India's DPDP Act needs verifiable parental consent under 18 (see decision.md).
MIN_SIGNUP_AGE=13
ACCOUNT_DELETION_GRACE_DAYS=30
REAUTH_WINDOW_MINUTES=10

# Google sign-in: comma-separated OAuth client IDs (Android, iOS, web). Empty = disabled (503).
GOOGLE_CLIENT_IDS=

# Email. Empty SMTP_URL = mail printed to the console (never in production).
# e.g. smtps://USER:PASS@smtp.example.com:465
SMTP_URL=
MAIL_FROM="MyVolApp <no-reply@myvolapp.local>"
